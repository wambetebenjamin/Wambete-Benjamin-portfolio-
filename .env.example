# ──────────────────────────────────────────────────────────────
# Wambete Benjamin — Portfolio environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit .env.local — it is gitignored.
# ──────────────────────────────────────────────────────────────

# Gmail SMTP credentials for the contact form (Nodemailer)
# SMTP_USER = your Gmail address          e.g. you@gmail.com
# SMTP_PASS = a Gmail *App Password* (NOT your normal password)
#   Create one: Google Account → Security → 2-Step Verification → App passwords
SMTP_USER=
SMTP_PASS=

# Where contact-form emails are delivered (defaults to SMTP_USER if empty)
CONTACT_TO=

# Optional SMTP overrides — defaults are smtp.gmail.com:465 (implicit TLS).
# For STARTTLS instead: SMTP_PORT=587 and SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# WhatsApp number in international format, no "+" (used by the Hire Me
# button and the floating chat widget)
NEXT_PUBLIC_WHATSAPP=254112272061

# Public site URL — used for SEO metadata, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://wambetebenjamin.vercel.app
